{
  "name": "opencode-mystatus",
  "version": "2.0.0",
  "description": "All-in-one AI quota status plugin. Supports OpenAI, Anthropic (Claude.ai), Google (Antigravity), GitHub Copilot, OpenCode Go, and Poe.",
  "type": "module",
  "main": "dist/plugin/mystatus.js",
  "types": "dist/plugin/mystatus.d.ts",
  "exports": {
    ".": {
      "import": "./dist/plugin/mystatus.js",
      "types": "./dist/plugin/mystatus.d.ts"
    }
  },
  "files": [
    "dist",
    "command",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "plugin",
    "quota",
    "status",
    "openai",
    "anthropic",
    "claude",
    "google",
    "antigravity",
    "copilot",
    "opencode-go",
    "poe"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlambos/opencode-mystatus.git"
  },
  "bugs": {
    "url": "https://github.com/schlambos/opencode-mystatus/issues"
  },
  "homepage": "https://github.com/schlambos/opencode-mystatus#readme",
  "dependencies": {
    "@opencode-ai/plugin": "1.1.27"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
